# Example environment variables for RAG system
# Copy this file to .env and fill in your values

# Logging
RAG_LOG_LEVEL=INFO

# Ollama Configuration
RAG_LLM__OLLAMA_BASE_URL=http://localhost:11434
RAG_LLM__MODEL=llama3.1

# OpenAI (Optional)
# RAG_LLM__PROVIDER=openai
# RAG_LLM__OPENAI_API_KEY=your-api-key-here

# Anthropic (Optional)
# RAG_LLM__PROVIDER=anthropic
# RAG_LLM__ANTHROPIC_API_KEY=your-api-key-here

# Embeddings
RAG_EMBEDDINGS__DEVICE=cpu
# RAG_EMBEDDINGS__DEVICE=cuda  # Uncomment for GPU

# Vector Store
RAG_VECTOR_STORE__TYPE=faiss
RAG_VECTOR_STORE__PERSIST_DIRECTORY=./vector_stores
RAG_VECTOR_STORE__COLLECTION_NAME=default

# Retrieval
RAG_RETRIEVAL__STRATEGY=hybrid
RAG_RETRIEVAL__TOP_K=5
RAG_RETRIEVAL__ENABLE_RERANKING=true

# Chunking
RAG_CHUNKING__STRATEGY=recursive
RAG_CHUNKING__CHUNK_SIZE=512
RAG_CHUNKING__CHUNK_OVERLAP=50

# Cache
RAG_CACHE_ENABLED=true
RAG_CACHE_DIR=./cache
